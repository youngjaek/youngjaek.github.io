---
layout: default
---
{%- comment -%}
  The home page is the interactive résumé: a hero, an expandable experience
  timeline filtered by stack, the case studies that sit behind those bullets,
  and recent writing. Everything is rendered server-side; JS only adds
  filtering, expansion niceties and reveal animation.
{%- endcomment -%}

<section class="hero">
  <div class="wrap">
    <p class="hero__status">
      <span class="status-dot" aria-hidden="true"></span>
      {{ site.availability }}
    </p>

    <h1 class="hero__title">{{ page.headline }}</h1>

    <p class="hero__lede">{{ page.lede }}</p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ '/work/' | relative_url }}">
        Read the case studies
        {% include icon.liquid name="arrow-right" %}
      </a>
      <a class="btn btn--secondary" href="{{ site.resume_pdf | relative_url }}">
        {% include icon.liquid name="file" %}
        Résumé (PDF)
      </a>
      <button class="btn btn--ghost copy-btn" type="button" data-copy="{{ site.email }}">
        <span class="copy-btn__idle">
          {% include icon.liquid name="copy" %}
          {{ site.email }}
        </span>
        <span class="copy-btn__done">
          {% include icon.liquid name="check" %}
          Copied
        </span>
      </button>
    </div>
  </div>
</section>

<!-- ------------------------------------------------------------ Experience -->
<section class="section" id="experience">
  <div class="wrap">
    <div class="section__head reveal">
      <div>
        <p class="eyebrow">Experience</p>
        <h2 class="section__title">Where I have shipped things</h2>
        <p class="section__lede">Expand a role to see what I actually built. Filter by a technology to see where it shows up.</p>
      </div>
      <a class="arrow-link" href="{{ site.resume_pdf | relative_url }}">
        Full résumé
        {% include icon.liquid name="arrow-right" %}
      </a>
    </div>

    <div class="filter reveal" data-filter role="group" aria-label="Filter experience by technology">
      <button class="filter__chip" type="button" data-value="all" aria-pressed="true">All</button>
      {%- for item in site.data.filters -%}
        <button class="filter__chip" type="button" data-value="{{ item | downcase }}" aria-pressed="false">{{ item }}</button>
      {%- endfor -%}
    </div>

    <div class="timeline reveal">
      {%- for job in site.data.experience -%}
        {%- assign stack_attr = job.stack | join: ' ' | downcase -%}
        <details
          class="role"
          data-stack="{{ stack_attr }}"
          {% if forloop.first %}
            open
          {% endif %}
        >
          <summary class="role__summary">
            <div>
              <div class="role__heading">
                <h3 class="role__title">{{ job.role }}</h3>
                <span class="role__org">{{ job.org }}</span>
              </div>
              <div class="role__sub">
                <span>{{ job.start }} — {{ job.end }}</span>
                <span>{{ job.location }}</span>
              </div>
            </div>
            <span class="role__chevron" aria-hidden="true">
              {% include icon.liquid name="chevron-down" %}
            </span>
          </summary>

          <div class="role__body">
            <ul class="role__points">
              {%- for point in job.points -%}
                <li>{{ point | markdownify | remove: '<p>' | remove: '</p>' }}</li>
              {%- endfor -%}
            </ul>

            <div class="role__footer">
              <ul class="tags">
                {%- for tech in job.stack -%}
                  <li class="tag">{{ tech }}</li>
                {%- endfor -%}
              </ul>

              {%- if job.case_study -%}
                {%- assign study = site.work | where: 'slug', job.case_study | first -%}
                {%- if study -%}
                  <a class="arrow-link" href="{{ study.url | relative_url }}">
                    Read the case study
                    {% include icon.liquid name="arrow-right" %}
                  </a>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- ---------------------------------------------------------- Selected work -->
<section class="section" id="work">
  <div class="wrap">
    <div class="section__head reveal">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 class="section__title">The long version</h2>
        <p class="section__lede">
          A résumé bullet is the outcome. These are the decisions, the tradeoffs and the parts that did not work the first time.
        </p>
      </div>
      <a class="arrow-link" href="{{ '/work/' | relative_url }}">
        All work
        {% include icon.liquid name="arrow-right" %}
      </a>
    </div>

    <div class="work-grid reveal">
      {%- assign featured = site.work | where: 'featured', true | sort: 'order' -%}
      {%- for study in featured -%}
        {%- assign stack_attr = study.stack | join: ' ' | downcase -%}
        <article class="card work-card" data-stack="{{ stack_attr }}">
          <div class="work-card__top">
            <span class="work-card__kind">{{ study.kind }}</span>
            <span class="card__meta">{{ study.period }}</span>
          </div>

          <h3 class="card__title">
            <a class="card__link" href="{{ study.url | relative_url }}">{{ study.title }}</a>
          </h3>
          <p class="card__desc">{{ study.summary }}</p>

          <ul class="tags">
            {%- for tech in study.stack limit: 4 -%}
              <li class="tag">{{ tech }}</li>
            {%- endfor -%}
          </ul>

          {%- if study.headline_metric -%}
            <p class="work-card__metric">
              <b>{{ study.headline_metric }}</b> {{ study.headline_metric_label }}
            </p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- ----------------------------------------------------------------- Stack -->
<section class="section" id="stack">
  <div class="wrap">
    <div class="section__head reveal">
      <div>
        <p class="eyebrow">Toolkit</p>
        <h2 class="section__title">What I reach for</h2>
      </div>
    </div>

    <div class="stack-grid reveal">
      {%- for group in site.data.stack -%}
        <div class="stack-group">
          <p class="stack-group__label">{{ group.label }}</p>
          <ul class="tags">
            {%- for item in group.items -%}
              <li class="tag">{{ item }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- --------------------------------------------------------------- Writing -->
{%- if site.posts.size > 0 -%}
  <section class="section" id="writing">
    <div class="wrap">
      <div class="section__head reveal">
        <div>
          <p class="eyebrow">Notes</p>
          <h2 class="section__title">Things I figured out and wrote down</h2>
        </div>
        <a class="arrow-link" href="{{ '/notes/' | relative_url }}">
          All notes
          {% include icon.liquid name="arrow-right" %}
        </a>
      </div>

      <div class="post-list reveal">
        {%- for post in site.posts limit: 3 -%}
          <article class="post-row">
            <div>
              <h3 class="post-row__title">
                <a class="card__link" href="{{ post.url | relative_url }}">{{ post.title }}</a>
              </h3>
              <p class="post-row__desc">{{ post.description }}</p>
            </div>
            <time class="post-row__date" datetime="{{ post.date | date_to_xmlschema }}">
              {{ post.date | date: '%b %d, %Y' }}
            </time>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<!-- --------------------------------------------------------------- Contact -->
<section class="section" id="contact">
  <div class="wrap">
    <div class="contact reveal">
      <div>
        <h2 class="contact__title">{{ page.contact_title }}</h2>
        <p class="contact__lede">{{ page.contact_lede }}</p>
      </div>
      <div class="contact__actions">
        <a class="btn btn--primary" href="mailto:{{ site.email }}">
          {% include icon.liquid name="mail" %}
          Get in touch
        </a>
        <a class="btn btn--secondary" href="{{ site.github_url }}" target="_blank" rel="noopener">
          {% include icon.liquid name="github" %}
          GitHub
        </a>
      </div>
    </div>
  </div>
</section>
