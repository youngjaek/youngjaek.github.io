---
layout: default
---
<div class="wrap wrap--prose">
  <header class="page-head">
    <p class="eyebrow">{{ page.eyebrow | default: page.title }}</p>
    <h1 class="page-head__title">{{ page.heading | default: page.title }}</h1>
    {%- if page.lede -%}
      <p class="page-head__lede">{{ page.lede }}</p>
    {%- endif -%}
  </header>

  <div class="prose">
    {{ content }}
  </div>
</div>
