---
layout: default
---
{%- assign words = content | strip_html | number_of_words -%}
{%- assign read_time = words | divided_by: 200 | plus: 1 -%}

<article class="wrap wrap--prose article">
  <a class="article__back" href="{{ '/notes/' | relative_url }}">
    {% include icon.liquid name="arrow-left" %}
    All notes
  </a>

  <h1 class="article__title">{{ page.title }}</h1>

  {%- if page.description -%}
    <p class="article__lede">{{ page.description }}</p>
  {%- endif -%}

  <div class="article__meta">
    <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%B %-d, %Y' }}</time>
    <span class="sep" aria-hidden="true"></span>
    <span>{{ read_time }} min read</span>
    {%- if page.tags.size > 0 -%}
      <span class="sep" aria-hidden="true"></span>
      <span>{{ page.tags | join: ' · ' }}</span>
    {%- endif -%}
  </div>

  <div class="article__divider" aria-hidden="true"></div>

  <div class="prose article__body">
    {{ content }}
  </div>

  {%- if page.previous or page.next -%}
    <nav class="article__nav" aria-label="More notes">
      {%- if page.previous -%}
        <a class="article__nav-item" href="{{ page.previous.url | relative_url }}">
          <span class="article__nav-dir">Previous</span>
          <p class="article__nav-title">{{ page.previous.title }}</p>
        </a>
      {%- endif -%}
      {%- if page.next -%}
        <a class="article__nav-item article__nav-item--next" href="{{ page.next.url | relative_url }}">
          <span class="article__nav-dir">Next</span>
          <p class="article__nav-title">{{ page.next.title }}</p>
        </a>
      {%- endif -%}
    </nav>
  {%- endif -%}
</article>
