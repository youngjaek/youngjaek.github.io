---
layout: default
---
{%- comment -%}
  Case-study layout. The fact panel and outcome tiles come from front matter so
  every study presents its context and results the same way, and the prose below
  is free to tell the story without repeating the metadata.
{%- endcomment -%}

<article class="wrap wrap--prose article">
  <a class="article__back" href="{{ '/work/' | relative_url }}">
    {% include icon.liquid name="arrow-left" %}
    All work
  </a>

  <p class="eyebrow">{{ page.kind }}</p>
  <h1 class="article__title">{{ page.title }}</h1>

  {%- if page.summary -%}
    <p class="article__lede">{{ page.summary }}</p>
  {%- endif -%}

  <div class="article__divider" aria-hidden="true"></div>

  <div class="facts">
    <div class="fact">
      <p class="fact__label">Context</p>
      <p class="fact__value">{{ page.org }}</p>
    </div>
    <div class="fact">
      <p class="fact__label">When</p>
      <p class="fact__value">{{ page.period }}</p>
    </div>
    <div class="fact">
      <p class="fact__label">Role</p>
      <p class="fact__value">{{ page.role }}</p>
    </div>
    {%- if page.repo -%}
      <div class="fact">
        <p class="fact__label">Source</p>
        <p class="fact__value">
          <a href="{{ page.repo }}" target="_blank" rel="noopener"> {{ page.repo | split: 'github.com/' | last }} ↗ </a>
        </p>
      </div>
    {%- endif -%}
  </div>

  {%- if page.outcomes.size > 0 -%}
    <div class="outcomes">
      {%- for outcome in page.outcomes -%}
        <div class="outcome">
          <p class="outcome__value">{{ outcome.value }}</p>
          <p class="outcome__label">{{ outcome.label }}</p>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="prose article__body">
    {{ content }}

    <h2>Stack</h2>
    <ul class="tags">
      {%- for tech in page.stack -%}
        <li class="tag">{{ tech }}</li>
      {%- endfor -%}
    </ul>
  </div>

  {%- assign studies = site.work | sort: 'order' -%}
  {%- assign total = studies.size -%}
  {%- for study in studies -%}
    {%- if study.url == page.url -%}
      {%- assign here = forloop.index0 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign prev_i = here | minus: 1 -%}
  {%- assign next_i = here | plus: 1 -%}

  {%- if total > 1 -%}
    <nav class="article__nav" aria-label="More case studies">
      {%- if prev_i >= 0 -%}
        {%- assign prev_study = studies[prev_i] -%}
        <a class="article__nav-item" href="{{ prev_study.url | relative_url }}">
          <span class="article__nav-dir">Previous</span>
          <p class="article__nav-title">{{ prev_study.title }}</p>
        </a>
      {%- endif -%}
      {%- if next_i < total -%}
        {%- assign next_study = studies[next_i] -%}
        <a class="article__nav-item article__nav-item--next" href="{{ next_study.url | relative_url }}">
          <span class="article__nav-dir">Next</span>
          <p class="article__nav-title">{{ next_study.title }}</p>
        </a>
      {%- endif -%}
    </nav>
  {%- endif -%}
</article>
