{%- comment -%}
  Replaces the theme head entirely. The theme version pulls in Tailwind,
  Google Fonts, FontAwesome and a stack of per-feature stylesheets; this site
  ships one self-hosted font and one stylesheet instead.
{%- endcomment -%}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

{%- assign page_title = page.title | default: site.title -%}
{%- if page.url == '/' -%}
  {%- assign full_title = site.author_name | append: ' — ' | append: site.tagline -%}
{%- else -%}
  {%- assign full_title = page_title | append: ' · ' | append: site.author_name -%}
{%- endif -%}
{%- assign page_desc = page.description | default: site.description | strip_newlines | strip -%}

<title>{{ full_title }}</title>
<meta name="description" content="{{ page_desc }}">
<meta name="author" content="{{ site.author_name }}">
<link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">

<!-- Open Graph / Twitter -->
<meta property="og:type" content="{% if page.layout == 'post' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ full_title }}">
<meta property="og:description" content="{{ page_desc }}">
<meta property="og:url" content="{{ page.url | absolute_url }}">
<meta property="og:site_name" content="{{ site.author_name }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ full_title }}">
<meta name="twitter:description" content="{{ page_desc }}">

<!-- Favicon: inline SVG monogram, so there is no extra request. -->
<link
  rel="icon"
  href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2224%22 fill=%22%230b0c0e%22/><text x=%2250%22 y=%2267%22 font-family=%22ui-monospace,monospace%22 font-size=%2248%22 font-weight=%22600%22 fill=%22%238f9bff%22 text-anchor=%22middle%22>YK</text></svg>"
>

{%- comment -%}
  Preload the font before the stylesheet is parsed. One latin-subset variable
  file covers every weight the design uses.
{%- endcomment -%}
<link
  rel="preload"
  href="{{ '/assets/fonts/inter-latin-var.woff2' | relative_url }}"
  as="font"
  type="font/woff2"
  crossorigin
>
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">

{%- if site.plugins contains 'jekyll-feed' %}
  <link rel="alternate" type="application/atom+xml" title="{{ site.author_name }}" href="{{ '/feed.xml' | absolute_url }}">
{%- endif %}

{%- comment -%}
  Theme resolution has to happen before first paint, otherwise a dark-mode
  visitor gets a white flash. Kept inline and tiny on purpose.
{%- endcomment -%}
<script>
  (function () {
    var root = document.documentElement;

    // Reveal animations are opt-in: elements are visible unless this class is
    // present. Armed here so there is no flash, and disarmed automatically if
    // site.js never gets a chance to run — a script failure must never leave
    // the page blank.
    root.classList.add('reveal-armed');
    window.__revealFallback = window.setTimeout(function () {
      root.classList.remove('reveal-armed');
    }, 2000);

    try {
      var saved = localStorage.getItem('theme');
      var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
      root.setAttribute('data-theme', saved || (prefersLight ? 'light' : 'dark'));
    } catch (e) {
      root.setAttribute('data-theme', 'dark');
    }
  })();
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": {{ site.author_name | jsonify }},
    "url": {{ site.url | append: site.baseurl | jsonify }},
    "email": {{ site.email | jsonify }},
    "jobTitle": {{ site.job_title | jsonify }},
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": {{ site.school | jsonify }}
    },
    "sameAs": [
      {{ site.github_url | jsonify }},
      {{ site.linkedin_url | jsonify }}
    ]
  }
</script>
