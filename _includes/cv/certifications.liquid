{%- comment -%}
  Local certification-card override for this portfolio.

  Renders each certification as a card carrying the issuing product's logo and a
  link to the public credential. The gem's version emitted a bare name/issuer
  row with an empty date column, which left a dangling dash.

  Consumes per entry: name, issuer, logo, url (public credential), date.
{%- endcomment -%}

<div class="cv-certs">
  {%- for entry in entries -%}
    <div class="cv-cert">
      <span class="cv-chip cv-chip--mark cv-cert-logo">
        {%- if entry.logo -%}
          <img
            src="{{ entry.logo | prepend: '/assets/img/logos/' | relative_url }}"
            alt=""
          >
        {%- else -%}
          <i class="fa-solid fa-certificate" aria-hidden="true"></i>
        {%- endif -%}
      </span>

      <div class="cv-cert-body">
        <div class="cv-cert-name">{{ entry.name }}</div>
        <div class="cv-cert-issuer">
          {{ entry.issuer -}}
          {%- if entry.date %} · {{ entry.date }}{% endif %}
        </div>

        {%- if entry.url %}
          <a class="cv-cert-verify" href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">
            Verify credential
            <i class="fa-solid fa-arrow-up-right-from-square fa-xs"></i>
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>
