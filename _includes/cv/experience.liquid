{%- comment -%}
  Local override of al_folio_cv's cv/experience.liquid.

  Leads with the organisation's logo on a light chip. The chip matters: these
  are official brand assets in their own colours (navy, black, blue), so a
  neutral light backdrop keeps every one of them legible in both the light and
  dark themes without recolouring anyone's logo.

  Consumes per entry: company, position, location, url, period, logo,
  logo_style ("mark" for a square brand mark), monogram, summary, highlights.
{%- endcomment -%}

<div class="cv-entries">
  {%- for entry in entries -%}
    {%- assign org = entry.company | default: entry.name | default: entry.organization -%}
    <div class="cv-entry">
      <div class="cv-logo">
        {%- if entry.logo -%}
          <span class="cv-chip {% if entry.logo_style == 'mark' %}cv-chip--mark{% endif %}">
            <img
              src="{{ entry.logo | prepend: '/assets/img/logos/' | relative_url }}"
              alt="{{ org }}"
            >
          </span>
        {%- else -%}
          <span class="cv-chip cv-chip--text" aria-hidden="true">
            {{- entry.monogram | default: org | slice: 0, 2 | upcase -}}
          </span>
        {%- endif -%}
      </div>

      <div class="cv-body">
        <h4 class="cv-role">{{ entry.position }}</h4>
        <p class="cv-org">
          {%- if entry.url -%}
            <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ org }}</a>
          {%- else -%}
            {{ org }}
          {%- endif -%}
        </p>

        <div class="cv-meta">
          {%- if entry.period -%}
            <span>{{ entry.period }}</span>
          {%- endif -%}
          {%- if entry.period and entry.location -%}<span class="cv-dot" aria-hidden="true"></span>{%- endif -%}
          {%- if entry.location -%}
            <span>{{ entry.location }}</span>
          {%- endif -%}
        </div>

        {%- if entry.summary %}
          <p class="cv-fact">{{ entry.summary }}</p>
        {%- endif -%}

        {%- if entry.highlights %}
          <ul class="cv-highlights">
            {%- for highlight in entry.highlights -%}
              <li>{{ highlight | markdownify | remove: '<p>' | remove: '</p>' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>
