{%- comment -%}
  Sticky header. Becomes a frosted bar only after scroll (see .is-stuck), so the
  hero reads as full-bleed at the top of the page.
{%- endcomment -%}

<header class="header" id="site-header" data-open="false">
  <div class="wrap header__inner">
    <a class="header__brand" href="{{ '/' | relative_url }}">
      <span class="brand__mark" aria-hidden="true">YK</span>
      <span>{{ site.author_name }}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Primary">
      {%- for item in site.data.nav -%}
        {%- if item.hide_in_nav -%}{%- continue -%}{%- endif -%}
        {%- assign item_url = item.url | relative_url -%}
        {%- assign is_current = false -%}
        {%- if item.url == '/' and page.url == '/' -%}
          {%- assign is_current = true -%}
        {%- elsif item.url != '/' and page.url contains item.url -%}
          {%- assign is_current = true -%}
        {%- endif -%}
        <a
          class="nav__link"
          href="{{ item_url }}"
          {% if is_current %}
            aria-current="page"
          {% endif %}
        >
          {{- item.title -}}
        </a>
      {%- endfor -%}
    </nav>

    <div class="header__right">
      <button
        class="palette-trigger"
        type="button"
        data-palette-open
        aria-haspopup="dialog"
        aria-label="Open command menu"
      >
        {% include icon.liquid name="search" %}
        <span class="palette-trigger__label">Jump to…</span>
        <kbd class="kbd">⌘K</kbd>
      </button>

      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle color theme">
        <span class="icon-btn__sun">{% include icon.liquid name="sun" %}</span>
        <span class="icon-btn__moon">{% include icon.liquid name="moon" %}</span>
      </button>

      <button
        class="icon-btn nav-toggle"
        type="button"
        data-nav-toggle
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        {% include icon.liquid name="menu" %}
      </button>
    </div>
  </div>
</header>
