<footer class="footer">
  <div class="wrap footer__inner">
    <p class="footer__note">
      © {{ site.time | date: '%Y' }}
      {{ site.author_name }}
    </p>

    <nav class="footer__links" aria-label="Elsewhere">
      <a href="mailto:{{ site.email }}">Email</a>
      <a href="{{ site.github_url }}" rel="me noopener" target="_blank">GitHub</a>
      <a href="{{ site.linkedin_url }}" rel="me noopener" target="_blank">LinkedIn</a>
      <a href="{{ site.resume_pdf | relative_url }}">Résumé</a>
      <a href="{{ '/feed.xml' | relative_url }}">RSS</a>
    </nav>
  </div>
</footer>
