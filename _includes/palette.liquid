{%- comment -%}
  Command palette (⌘K / Ctrl+K).

  The whole index is rendered server-side as real links, so there is no JSON
  fetch, the entries work with JS disabled once the dialog is open, and search
  is a plain substring match over `data-keywords`. <dialog> gives us focus
  trapping, Esc-to-close and inert background for free.
{%- endcomment -%}

<dialog class="palette" id="command-palette" aria-label="Command menu">
  <div class="palette__search">
    {% include icon.liquid name="search" %}
    <input
      class="palette__input"
      id="palette-input"
      type="text"
      placeholder="Search pages, case studies and notes…"
      autocomplete="off"
      spellcheck="false"
      aria-controls="palette-list"
      aria-autocomplete="list"
    >
  </div>

  <div class="palette__list" id="palette-list" role="listbox" aria-label="Results">
    <p class="palette__group" data-group>Pages</p>
    {%- for item in site.data.nav -%}
      <a
        class="palette__item"
        role="option"
        href="{{ item.url | relative_url }}"
        data-keywords="{{ item.title | downcase }} {{ item.keywords | default: '' | downcase }}"
      >
        {% include icon.liquid name=item.icon %}
        <span>{{ item.title }}</span>
      </a>
    {%- endfor -%}

    {%- assign studies = site.work | sort: 'order' -%}
    {%- if studies.size > 0 -%}
      <p class="palette__group" data-group>Case studies</p>
      {%- for study in studies -%}
        <a
          class="palette__item"
          role="option"
          href="{{ study.url | relative_url }}"
          data-keywords="{{ study.title | downcase }} {{ study.org | downcase }} {{ study.stack | join: ' ' | downcase }}"
        >
          {% include icon.liquid name="layers" %}
          <span>{{ study.title }}</span>
          <span class="palette__hint">{{ study.org }}</span>
        </a>
      {%- endfor -%}
    {%- endif -%}

    {%- if site.posts.size > 0 -%}
      <p class="palette__group" data-group>Notes</p>
      {%- for post in site.posts limit: 12 -%}
        <a
          class="palette__item"
          role="option"
          href="{{ post.url | relative_url }}"
          data-keywords="{{ post.title | downcase }} {{ post.tags | join: ' ' | downcase }}"
        >
          {% include icon.liquid name="pen" %}
          <span>{{ post.title }}</span>
          <span class="palette__hint">{{ post.date | date: '%b %Y' }}</span>
        </a>
      {%- endfor -%}
    {%- endif -%}

    <p class="palette__group" data-group>Actions</p>
    <button
      class="palette__item"
      role="option"
      type="button"
      data-action="theme"
      data-keywords="theme dark light appearance toggle"
    >
      {% include icon.liquid name="spark" %}
      <span>Toggle color theme</span>
    </button>
    <button
      class="palette__item"
      role="option"
      type="button"
      data-action="copy-email"
      data-copy="{{ site.email }}"
      data-keywords="email copy contact address reach"
    >
      {% include icon.liquid name="mail" %}
      <span>Copy email address</span>
      <span class="palette__hint">{{ site.email }}</span>
    </button>
    <a
      class="palette__item"
      role="option"
      href="{{ site.resume_pdf | relative_url }}"
      data-keywords="resume cv pdf download"
    >
      {% include icon.liquid name="file" %}
      <span>Download résumé (PDF)</span>
    </a>
    <a
      class="palette__item"
      role="option"
      href="{{ site.github_url }}"
      target="_blank"
      rel="noopener"
      data-keywords="github code repositories source"
    >
      {% include icon.liquid name="github" %}
      <span>GitHub</span>
      <span class="palette__hint">↗</span>
    </a>
    <a
      class="palette__item"
      role="option"
      href="{{ site.linkedin_url }}"
      target="_blank"
      rel="noopener"
      data-keywords="linkedin profile network"
    >
      {% include icon.liquid name="linkedin" %}
      <span>LinkedIn</span>
      <span class="palette__hint">↗</span>
    </a>

    <p class="palette__empty" id="palette-empty" hidden>No matches.</p>
  </div>

  <div class="palette__footer">
    <span><kbd class="kbd">↑↓</kbd> navigate</span>
    <span><kbd class="kbd">↵</kbd> open</span>
    <span><kbd class="kbd">esc</kbd> close</span>
  </div>
</dialog>
